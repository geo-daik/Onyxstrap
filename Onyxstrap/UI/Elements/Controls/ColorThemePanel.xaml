<UserControl x:Class="Onyxstrap.UI.Elements.Controls.ColorThemePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <Border Padding="20" CornerRadius="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
  <StackPanel>
   <TextBlock Text="Make it your color" FontSize="21" FontWeight="SemiBold" />
   <TextBlock Text="20 presets or any custom shade. Preview here, then Save to keep your theme." TextWrapping="Wrap" Margin="0,5,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
   <ItemsControl ItemsSource="{Binding Swatches}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Width="32" Height="32" Padding="0" Margin="0,0,7,7" Background="{Binding Brush}" Tag="{Binding Value}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Click="SwatchClick" BorderThickness="1" BorderBrush="#60808080" />
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <WrapPanel Margin="0,5,0,8">
    <Ellipse Width="14" Height="14" Fill="{Binding PreviewBrush}" Margin="0,0,7,0" />
    <TextBlock Text="{Binding SelectionLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0" />
    <TextBox Width="108" MaxLength="7" Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Onyxstrap custom hex color" Margin="0,0,8,0" />
    <Button Content="Pick color…" Padding="12,6" Click="PickAppColor" />
   </WrapPanel>
   <TextBlock Text="Spotify player" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,9" />
   <WrapPanel>
    <ComboBox MinWidth="190" ItemsSource="{Binding PlayerModes}" SelectedItem="{Binding PlayerMode}" Margin="0,0,8,8" AutomationProperties.Name="Spotify color mode">
     <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumNameConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBox Width="108" MaxLength="7" Text="{Binding PlayerHex, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Spotify custom hex color" Margin="0,0,8,8" ToolTip="Own color; also used when an album cover has no usable color" />
    <Button Content="Pick color…" Padding="12,6" Click="PickPlayerColor" Margin="0,0,0,8" />
   </WrapPanel>
   <CheckBox Content="Compact player" IsChecked="{Binding Compact}" Margin="0,2,0,4" />
   <TextBlock Text="Album mode follows the cover art. Compact mode keeps the cover and playback controls in a smaller panel." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
   <TextBlock Text="Theme profiles" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,9" />
   <WrapPanel>
    <TextBox Width="175" MaxLength="48" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Theme profile name" ToolTip="Name your profile" Margin="0,0,8,8" />
    <Button Content="Save profile" Command="{Binding SaveProfileCommand}" Padding="12,6" Margin="0,0,8,8" />
   </WrapPanel>
   <WrapPanel>
    <ComboBox Width="175" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="Saved theme profiles" Margin="0,0,8,8" />
    <Button Content="Apply" Command="{Binding ApplyProfileCommand}" Padding="12,6" Margin="0,0,8,8" />
    <Button Content="Remove" Command="{Binding DeleteProfileCommand}" Padding="12,6" Margin="0,0,8,8" />
    <Button Content="Reset colors" Command="{Binding ResetColorsCommand}" Padding="12,6" Margin="0,0,0,8" />
   </WrapPanel>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
   <TextBlock Text="These colors apply to Onyxstrap and its Spotify overlay. Roblox’s native menu theme is managed in Roblox." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0" />
  </StackPanel>
 </Border>
</UserControl>
