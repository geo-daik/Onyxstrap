<ui:UiPage x:Class="Onyxstrap.UI.Elements.Settings.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:Onyxstrap.UI.ViewModels.Settings"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Onyxstrap.Resources"
      xmlns:controls="clr-namespace:Onyxstrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="AccountsPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <ui:UiPage.Resources>
        <QuadraticEase x:Key="SilkEase" EasingMode="EaseInOut" />
    </ui:UiPage.Resources>
    <ui:UiPage.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageContent" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetName="PageSlide" Storyboard.TargetProperty="Y" From="14" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource SilkEase}" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </ui:UiPage.Triggers>
    <StackPanel x:Name="PageContent" Margin="0,0,14,14">
        <StackPanel.RenderTransform>
            <TranslateTransform x:Name="PageSlide" Y="0" />
        </StackPanel.RenderTransform>
        <TextBlock Margin="0,0,0,16" Text="{x:Static resources:Strings.Accounts_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <ui:CardAction Icon="PersonAdd24" Command="{Binding AddAccountCommand, Mode=OneTime}">
            <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Accounts_AddAccount}" />
            </StackPanel>
        </ui:CardAction>

        <TextBlock Margin="0,16,0,8" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{x:Static resources:Strings.Accounts_NoAccounts}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNoAccounts}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding AccountEntries, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,8" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                    BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding Avatar}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <ui:SymbolIcon Symbol="Person24" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Medium" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{x:Static resources:Strings.Accounts_ActiveBadge}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <Run Text="@" /><Run Text="{Binding UserId, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Margin="4,0,0,0" Appearance="Primary" Icon="PersonAvailable24" Content="{x:Static resources:Strings.Accounts_SetActive}"
                                           Command="{Binding SetActiveCommand}"
                                           ToolTip="{x:Static resources:Strings.Accounts_SetActive}">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Margin="4,0,0,0" Appearance="Primary" Icon="Play24" Content="{x:Static resources:Strings.Accounts_Launch}" Command="{Binding LaunchCommand}" />
                                <ui:Button Margin="4,0,0,0" Icon="Edit16" Command="{Binding RenameCommand}" ToolTip="{x:Static resources:Strings.Accounts_Rename}" />
                                <ui:Button Margin="4,0,0,0" Appearance="Danger" Icon="Delete16" Command="{Binding RemoveCommand}" ToolTip="{x:Static resources:Strings.Accounts_Remove}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{x:Static resources:Strings.Accounts_PresetsTitle}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

        <ui:CardAction Icon="Save24" Command="{Binding SavePresetCommand, Mode=OneTime}">
            <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Accounts_SavePreset}" />
            </StackPanel>
        </ui:CardAction>

        <ItemsControl ItemsSource="{Binding PresetNames, Mode=OneWay}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" Text="{Binding}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Margin="4,0,0,0" Appearance="Primary" Icon="ArrowDownLeft16" Content="{x:Static resources:Strings.Accounts_ApplyPreset}"
                                           Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <ui:Button Margin="4,0,0,0" Appearance="Danger" Icon="Delete16" Content="{x:Static resources:Strings.Accounts_Remove}"
                                           Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
