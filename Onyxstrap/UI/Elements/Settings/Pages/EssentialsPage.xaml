<ui:UiPage x:Class="Onyxstrap.UI.Elements.Settings.Pages.EssentialsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Essentials" Scrollable="True" Loaded="OnLoaded">
 <StackPanel Margin="0,0,16,16">
  <TextBlock Text="Your everyday essentials" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Text="Favorite games, a player that stays in place, and a backup of your setup." Margin="0,6,0,18" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
  <Border Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
   <StackPanel>
    <TextBlock Text="Quick-launch favorites" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="Add a name and a Roblox game link or place ID. Favorites launch using your current Roblox session." TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="GameName" MaxLength="60" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Favorite name" AutomationProperties.Name="Favorite name"/>
     <TextBox x:Name="GameLink" Grid.Column="1" MaxLength="2048" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Roblox game link or place ID" AutomationProperties.Name="Roblox game link or place ID"/>
     <ui:Button Grid.Column="2" Content="Add" Appearance="Primary" Click="Add_Click"/>
    </Grid>
    <Grid Margin="0,3,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
     <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     <TextBlock Grid.Column="1" Text="Game link or place ID" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Grid>
    <TextBlock x:Name="EmptyLabel" Text="Your favorite games will appear here." Margin="0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <ListBox x:Name="Favorites" MaxHeight="150" Margin="0,4,0,8" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Favorite games">
     <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <ui:Button Content="Play" Appearance="Primary" Click="Play_Click" Tag="{Binding PlaceId}" Margin="8,0"/>
       <ui:Button Content="Remove" Click="Remove_Click" Tag="{Binding}"/>
      </StackPanel>
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
     </DockPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </StackPanel>
  </Border>
  <Border Margin="0,12,0,0" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="Spotify edge snapping" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="Drag close to an edge to snap the player into place. Its position is remembered separately for each monitor. Save to apply." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <ui:ToggleSwitch x:Name="SnapToggle" Grid.Column="1" IsChecked="{Binding SpotifySnapToEdges, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Snap Spotify player to edges"/>
   </Grid>
  </Border>
  <Border Margin="0,12,0,0" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
   <StackPanel>
    <TextBlock Text="Back up your setup" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="Export your appearance, Spotify and Discord preferences, color profiles, and favorites. Account sessions, custom commands, and local files are excluded." TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <WrapPanel><ui:Button Content="Export backup" Click="Export_Click" Margin="0,0,8,0"/><ui:Button Content="Import backup" Click="Import_Click"/></WrapPanel>
   </StackPanel>
  </Border>
  <TextBlock x:Name="Status" Text="Click Save to keep changes to favorites and snapping." TextWrapping="Wrap" Margin="0,12,0,0"/>
 </StackPanel>
</ui:UiPage>
