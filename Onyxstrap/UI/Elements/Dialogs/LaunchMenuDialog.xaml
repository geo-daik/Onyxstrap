<base:WpfUiWindow x:Class="Onyxstrap.UI.Elements.Dialogs.LaunchMenuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Onyxstrap.UI.Elements.Dialogs"
        xmlns:base="clr-namespace:Onyxstrap.UI.Elements.Base"
        xmlns:models="clr-namespace:Onyxstrap.UI.ViewModels"
        xmlns:resources="clr-namespace:Onyxstrap.Resources"
        mc:Ignorable="d"
        Title="Onyxstrap"
        MinWidth="0"
        MinHeight="0"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True">
    <base:WpfUiWindow.Resources>
        <QuadraticEase x:Key="SilkEase" EasingMode="EaseInOut" />

        <!-- gem breathing loop -->
        <Storyboard x:Key="GemLoop" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GemBreathe" Storyboard.TargetProperty="ScaleX" From="1" To="1.05" Duration="0:0:1.8" EasingFunction="{StaticResource SilkEase}" />
            <DoubleAnimation Storyboard.TargetName="GemBreathe" Storyboard.TargetProperty="ScaleY" From="1" To="1.05" Duration="0:0:1.8" EasingFunction="{StaticResource SilkEase}" />
            <DoubleAnimation Storyboard.TargetName="GemGlow" Storyboard.TargetProperty="BlurRadius" From="22" To="40" Duration="0:0:1.8" EasingFunction="{StaticResource SilkEase}" />
            <DoubleAnimation Storyboard.TargetName="GemGlow" Storyboard.TargetProperty="Opacity" From="0.4" To="0.75" Duration="0:0:1.8" EasingFunction="{StaticResource SilkEase}" />
        </Storyboard>

        <!-- slow diagonal light sweep across the panel -->
        <Storyboard x:Key="SweepLoop" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepSlide" Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-300" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="760" KeySpline="0.4,0 0.6,1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:6" Value="760" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- hover-slide for the action tiles -->
        <Style BasedOn="{StaticResource {x:Type ui:CardAction}}" TargetType="ui:CardAction">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="5" Duration="0:0:0.16" EasingFunction="{StaticResource SilkEase}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource SilkEase}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </base:WpfUiWindow.Resources>

    <base:WpfUiWindow.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource GemLoop}" />
            <BeginStoryboard Storyboard="{StaticResource SweepLoop}" />
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource SilkEase}" />
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource SilkEase}" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </base:WpfUiWindow.Triggers>

    <Border x:Name="RootPanel" CornerRadius="16" BorderBrush="#268A80DC" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Border.RenderTransform>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1B1728" Offset="0" />
                <GradientStop Color="#FF100E19" Offset="0.55" />
                <GradientStop Color="#FF0B0912" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="#140C28" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- light sweep -->
            <Rectangle Panel.ZIndex="1" IsHitTestVisible="False" Width="240" HorizontalAlignment="Left">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="SweepSlide" X="-300" />
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#12FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ambient glow -->
            <Ellipse Grid.Row="0" Grid.RowSpan="2" Width="420" Height="420" Margin="-160,-180,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3D6C5CE7" Offset="0" />
                        <GradientStop Color="#006C5CE7" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" Padding="8" ShowMinimize="False" ShowMaximize="False" Title="Onyxstrap" Icon="pack://application:,,,/Onyxstrap.ico" CanMaximize="False" KeyboardNavigation.TabNavigation="None" Background="Transparent" />

            <Grid Grid.Row="1" Margin="28,10,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- hero -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Image Width="92" Height="92" HorizontalAlignment="Left" Source="pack://application:,,,/Onyxstrap.ico" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="GemBreathe" CenterX="46" CenterY="46" />
                        </Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect x:Name="GemGlow" BlurRadius="22" ShadowDepth="0" Color="#8A80DC" Opacity="0.4" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Margin="0,14,0,0" Text="O N Y X S T R A P" FontFamily="{StaticResource Rubik}" FontSize="19" FontWeight="SemiBold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush>
                                <GradientStop Color="#FFE8E6F2" Offset="0" />
                                <GradientStop Color="#FFB9AFFF" Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" FontFamily="{StaticResource Rubik}" FontSize="12" Foreground="#99B9AFFF" Text="forged for Roblox" />
                    <TextBlock Margin="0,14,0,0" FontFamily="{StaticResource Rubik}" FontSize="12" Foreground="#77E8E6F2" Text="{Binding Version, Mode=OneTime}" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <ui:Hyperlink Icon="QuestionCircle48" FontSize="12" Content="{x:Static resources:Strings.About_Title}" Command="{Binding LaunchAboutCommand, Mode=OneTime}" />
                        <ui:Hyperlink Margin="14,0,0,0" FontSize="12" Icon="Book24" Content="{x:Static resources:Strings.LaunchMenu_OnyxstrapWiki}" NavigateUri="https://onyxstrap.dev/wiki/" />
                        <ui:Hyperlink Margin="14,0,0,0" FontSize="12" Icon="PeopleCommunity28" Content="{x:Static resources:Strings.LaunchMenu_RobloxCommunity}" NavigateUri="https://www.roblox.com/communities/32380007/Onyxstrap" />
                    </StackPanel>
                </StackPanel>

                <!-- actions -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <ui:CardAction Icon="ArrowRight12" TabIndex="0" Command="{Binding LaunchRobloxCommand, Mode=OneTime}">
                        <StackPanel>
                            <TextBlock FontSize="14" Text="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}" />
                        </StackPanel>
                    </ui:CardAction>

                    <ui:CardAction Margin="0,8,0,0" Icon="Wrench24" Command="{Binding LaunchRobloxStudioCommand, Mode=OneTime}">
                        <StackPanel>
                            <TextBlock FontSize="14" Text="{x:Static resources:Strings.LaunchMenu_LaunchRobloxStudio}" />
                        </StackPanel>
                    </ui:CardAction>

                    <ui:CardAction Margin="0,8,0,0" TabIndex="1" Icon="Settings28" Command="{Binding LaunchSettingsCommand, Mode=OneTime}">
                        <StackPanel>
                            <TextBlock FontSize="14" Text="{x:Static resources:Strings.LaunchMenu_ConfigureSettings}" />
                        </StackPanel>
                    </ui:CardAction>

                    <ui:CardAction Margin="0,8,0,0" TabIndex="2" Icon="BookQuestionMark24" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/geo-daik/Onyxstrap/wiki/">
                        <StackPanel>
                            <TextBlock FontSize="14" Text="{x:Static resources:Strings.LaunchMenu_Wiki_Title}" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.LaunchMenu_Wiki_Description}" Padding="0,0,16,0" Foreground="#77E8E6F2" />
                        </StackPanel>
                    </ui:CardAction>

                    <StackPanel x:Name="AccountsSection" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="L A U N C H   A S" FontFamily="{StaticResource Rubik}" FontSize="11" FontWeight="SemiBold" Foreground="#99B9AFFF" Margin="0,0,0,6" />
                        <ItemsControl x:Name="AccountsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardAction Margin="0,0,0,6" Click="AccountLaunch_Click" Tag="{Binding Id}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="26" Height="26" Source="{Binding Avatar}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Name}" />
                                            <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="9" VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="White" Text="ACTIVE" />
                                            </Border>
                                        </StackPanel>
                                    </ui:CardAction>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</base:WpfUiWindow>
