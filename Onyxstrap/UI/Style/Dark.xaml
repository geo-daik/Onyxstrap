<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Onyx theme surfaces (dark): near-black with a violet tint -->
    <Color x:Key="ApplicationBackgroundColor">#FF0F0D16</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF0F0D16" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF13111D" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF171524" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF1D1B2C" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FF232033" />

    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#14121D" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="#E8E6F2" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#8A80DC" />
</ResourceDictionary>
