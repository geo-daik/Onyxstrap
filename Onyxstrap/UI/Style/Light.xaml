<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Onyx theme surfaces (light): clean surfaces with a whisper of violet -->
    <Color x:Key="ApplicationBackgroundColor">#FFFBFAFD</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFFBFAFD" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFF6F5FA" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFF1F0F8" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FFEDECF6" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FFE8E6F3" />

    <SolidColorBrush x:Key="NewTextEditorBackground" Color="White" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="Black" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#7C6FD8" />
</ResourceDictionary>
